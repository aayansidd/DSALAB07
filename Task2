#include <iostream>
using namespace std;
struct node {
    int data;
    node* next;
};

struct LinkedQueue {
    node* head = nullptr;
    node* curr = nullptr;
    node* temp = nullptr;
    node* tail = nullptr;
    void enqueue(int val){
        node* newnode = new node;
        newnode->next = nullptr;
        newnode->data = val;


        if (head == nullptr) {
            head = newnode;
            tail = head;
        }else {
            tail->next = newnode;
            tail = newnode;
        }
    }

    void dequeue() {
        if (head == nullptr) {
            cout << "Queue is empty" << endl;
        } else {
            node* temp = head; // Local variable for cleanup
            cout << "Value removed: " << head->data << endl;

            head = head->next;
            delete temp; // Prevent memory leaks

            // If the queue becomes empty, make sure to reset tail as well
            if (head == nullptr) {
                tail = nullptr;
            }
        }

    }

    void peek() {
        if (head == nullptr) {
            cout << "Queue empty" << endl;
        }else {
            cout << "Value at Head: " << head->data;
        }

    }

    bool isEmpty() {
        if (head == nullptr) {
            return true;
        }
        return false;
    }

    void display() {
        curr = head;
        while (curr != nullptr) {
            cout << curr->data << "->";
            curr = curr->next;
        }
        cout << "End" << endl;
    }
};

int main() {
    LinkedQueue myQueue;

    myQueue.enqueue(10);
    myQueue.enqueue(20);
    myQueue.enqueue(30);
    myQueue.dequeue();
    myQueue.display();
    myQueue.dequeue();
    myQueue.dequeue();
    myQueue.dequeue();
    myQueue.enqueue(30);
    myQueue.display();
}
